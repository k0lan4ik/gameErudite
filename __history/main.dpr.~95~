end;

function CheckWordInDictionary(word: string; var dictionary: TWordDictionary;
  var index: Integer): Boolean;
(* var AddNewWord: Boolean;
  Choise: Char; *)
var
  left, right, mid: Integer;
begin
  result := False;
  left := 1;
  right := StrToInt(dictionary[0]);
  while (left <= right) do
  begin
    mid := (left + right) div 2;
    if word = dictionary[mid] then
    begin
      result := True;
      left := right + 1;
    end
    else if word > dictionary[mid] then
    begin
      left := mid + 1;
      index := left;
    end
    else
    begin
      right := mid - 1;
      index := mid;
    end;
  end;
  if not result then
  begin
    result := False;
  end;
end;
